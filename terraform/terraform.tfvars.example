# Not secret. Credentials come from AWS_PROFILE in your shell.
account_id     = "<YOUR_ACCOUNT_ID>"
region         = "eu-west-1"
connection_arn = "arn:aws:codeconnections:eu-west-1:<YOUR_ACCOUNT_ID>:connection/<CONNECTION_ID>"
github_owner   = "<YOUR_GITHUB_USER>"

# Optional: HTTPS on your own domain. Needs an existing public Route 53 zone and an ISSUED
# ACM certificate (same region) covering both hostnames. Leave these out for plain HTTP
# on the load balancer's DNS name.
# domain_zone = "lab.example.com"
# web_host    = "pay.lab.example.com"
# api_host    = "api.lab.example.com"
# certificate_domain = "*.lab.example.com"   # only if your certificate is a wildcard
