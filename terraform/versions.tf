terraform {
  required_version = ">= 1.6.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Local state (terraform.tfstate in this folder). Keep it on this laptop:
  # without it, Terraform can't update or destroy what it created.
}
