<mxfile host="app.diagrams.net">
  <diagram id="paylab-arch" name="PayLab on AWS">
    <mxGraphModel dx="2400" dy="1500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2420" pageHeight="1500" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>


        <!-- ================= BRAND ================= -->
        <mxCell id="brand-logo" value="" style="shape=image;verticalLabelPosition=bottom;verticalAlign=top;imageAspect=0;aspect=fixed;image=data:image/png,;" vertex="1" parent="1">
          <mxGeometry x="20" y="-140" width="330" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="brand-title" value="&lt;b style=&quot;font-size:26px&quot;&gt;PayLab — Payment Web App on AWS ECS Fargate&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:15px;color:#5A6472&quot;&gt;aricxpoint labs · DevOps class · Toba Oyetola&lt;/span&gt;" style="text;html=1;fontColor=#232F3E;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="380" y="-130" width="1000" height="80" as="geometry"/>
        </mxCell>

        <!-- ================= TITLE ================= -->
        <mxCell id="title" value="&lt;b&gt;aricxpoint labs · PayLab&lt;/b&gt; — payment app on Amazon ECS (Fargate) in eu-west-1, one CI/CD pipeline per service. Numbers ①–⑦ follow one payment; see the notes on the right." style="text;html=1;fontSize=18;fontColor=#232F3E;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="20" y="15" width="1940" height="40" as="geometry"/>
        </mxCell>

        <!-- ================= OUTSIDE AWS ================= -->
        <mxCell id="cloudflare" value="&lt;i&gt;Optional&lt;/i&gt;&lt;br&gt;&lt;b&gt;Your DNS provider&lt;/b&gt;&lt;br&gt;(e.g. Cloudflare for aricxpoint.co)&lt;br&gt;NS records: &lt;i&gt;lab&lt;/i&gt; → Route 53" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF1E3;strokeColor=#F48120;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="140" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="users" value="&lt;b&gt;Users&lt;/b&gt;&lt;br&gt;browser / phone" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#232F3D;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=12;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.users;" vertex="1" parent="1">
