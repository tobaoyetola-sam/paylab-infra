        <mxCell id="github" value="&lt;b&gt;GitHub&lt;/b&gt; · your forks&lt;br&gt;paylab-web&lt;br&gt;paylab-api-gateway&lt;br&gt;paylab-payment-svc&lt;br&gt;paylab-wallet-svc&lt;br&gt;paylab-notify-svc&lt;br&gt;&lt;i&gt;(+ paylab-infra: Terraform)&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#24292F;strokeColor=#24292F;fontColor=#FFFFFF;fontSize=11;align=left;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="20" y="1240" width="210" height="130" as="geometry"/>
