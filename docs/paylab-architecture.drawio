        <mxCell id="e-dev-gh" value="git push main" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#24292F;" edge="1" parent="1" source="dev" target="github">
