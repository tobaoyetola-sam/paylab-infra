        </mxCell>
        <mxCell id="az-b" value="Availability Zone eu-west-1b" style="fillColor=none;strokeColor=#147EBA;dashed=1;verticalAlign=top;fontStyle=0;fontColor=#147EBA;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;" vertex="1" parent="1">
