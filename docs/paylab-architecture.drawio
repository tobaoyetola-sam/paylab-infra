        <mxCell id="e-gh-conn" value="push event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=6;fontSize=10;labelBackgroundColor=#FFFFFF;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#C925D1;" edge="1" parent="1" source="github" target="conn">
