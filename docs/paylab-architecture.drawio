        </mxCell>
        <mxCell id="cw" value="&lt;b&gt;Amazon CloudWatch Logs&lt;/b&gt;&lt;br&gt;/ecs/paylab (one stream per task)&lt;br&gt;/aws/codebuild/paylab-&amp;lt;service&amp;gt;-build" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1530" y="940" width="56" height="56" as="geometry"/>
        </mxCell>

        <!-- ================= CI/CD LANE ================= -->
        <mxCell id="cicd" value="CI/CD · one pipeline per GitHub repo (×5) · triggered by every push to main · only the pushed service redeploys" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F7F2FC;strokeColor=#C925D1;dashed=1;verticalAlign=top;align=left;spacingLeft=10;fontStyle=1;fontColor=#7D1A87;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="330" y="1110" width="1590" height="330" as="geometry"/>
        </mxCell>
        <mxCell id="conn" value="&lt;b&gt;AWS CodeConnections&lt;/b&gt;&lt;br&gt;&quot;aricxpoint&quot; (GitHub app)&lt;br&gt;&lt;i&gt;kept on destroy&lt;/i&gt;" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codestar;" vertex="1" parent="1">
          <mxGeometry x="400" y="1180" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="pipe" value="&lt;b&gt;AWS CodePipeline&lt;/b&gt; (V2)&lt;br&gt;paylab-&amp;lt;service&amp;gt;-pipeline&lt;br&gt;Source → Build → Deploy" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codepipeline;" vertex="1" parent="1">
          <mxGeometry x="700" y="1180" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="build" value="&lt;b&gt;AWS CodeBuild&lt;/b&gt;&lt;br&gt;paylab-&amp;lt;service&amp;gt;-build&lt;br&gt;runs buildspec.yml (docker build)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.codebuild;" vertex="1" parent="1">
          <mxGeometry x="1000" y="1180" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;Amazon S3&lt;/b&gt;&lt;br&gt;paylab-artifacts-&amp;lt;account&amp;gt;-eu-west-1&lt;br&gt;(source zip, imagedefinitions.json)" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1">
          <mxGeometry x="704" y="1340" width="48" height="48" as="geometry"/>
        </mxCell>
        <mxCell id="deploy" value="&lt;b&gt;Deploy stage · Amazon ECS action&lt;/b&gt;&lt;br&gt;new task definition revision with the new image,&lt;br&gt;rolling update; old task stops after the new one passes /health" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7EF;strokeColor=#ED7100;fontColor=#232F3E;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1175" width="330" height="70" as="geometry"/>
        </mxCell>

        <!-- ================= NOTES PANEL ================= -->
        <mxCell id="notes" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:14px&quot;&gt;How to read this diagram&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Boxes inside boxes&lt;/b&gt; = where things live: AWS Cloud → Region → VPC → Availability Zone → public subnet → security group. Services outside the VPC (right column, CI/CD) are regional AWS services reached over AWS endpoints.&lt;br&gt;&lt;br&gt;&lt;b&gt;One payment, step by step&lt;/b&gt;&lt;br&gt;① With a domain, the browser looks up pay.&amp;lt;domain&amp;gt; (e.g. pay.lab.aricxpoint.co): your DNS delegates &lt;i&gt;lab&lt;/i&gt; to Route 53, which answers with the ALB. Without a domain, browse http://&amp;lt;ALB DNS name&amp;gt; and skip this step.&lt;br&gt;② HTTPS :443 (or HTTP :80 without a domain) enters through the internet gateway to the ALB (cert from ACM). Port 80 is redirected to 443.&lt;br&gt;③ ALB routes: / → web (page), /api/* or api.lab → api-gateway.&lt;br&gt;④ api-gateway calls payment-svc.paylab.internal:8081 (and wallet-svc for wallet lookups). The name resolves in the private zone to the current task IP.&lt;br&gt;⑤ payment-svc calls wallet-svc /transfers: debit payer + credit payee + 2 ledger rows in ONE database transaction.&lt;br&gt;⑥ payment-svc calls notify-svc /notify: a sent and a received receipt are logged.&lt;br&gt;⑦ payment-svc and wallet-svc use RDS on 5432 over TLS.&lt;br&gt;&lt;br&gt;&lt;b&gt;Service discovery (Cloud Map)&lt;/b&gt;&lt;br&gt;Fargate tasks get a new private IP every time they start. ECS registers each task in Cloud Map; Cloud Map writes an A record (TTL 10 s) in the private zone paylab.internal and removes it when the task stops. Code only ever uses names.&lt;br&gt;&lt;br&gt;&lt;b&gt;Security&lt;/b&gt;&lt;br&gt;• Only the ALB is open to the internet (alb-sg).&lt;br&gt;• Tasks accept traffic only from the ALB and each other (app-sg).&lt;br&gt;• RDS accepts only app-sg and is not public (db-sg).&lt;br&gt;• /transfers is internal: api-gateway never forwards it.&lt;br&gt;• The DB password is injected from Parameter Store at task start; it is never in code or the task definition.&lt;br&gt;• Lab shortcut: public subnets + task public IPs instead of private subnets + NAT gateway.&lt;br&gt;&lt;br&gt;&lt;b&gt;CI/CD (bottom lane)&lt;/b&gt;&lt;br&gt;git push → CodeConnections → CodePipeline &lt;i&gt;Source&lt;/i&gt; → CodeBuild &lt;i&gt;Build&lt;/i&gt; (docker build, push image to ECR, write imagedefinitions.json) → ECS &lt;i&gt;Deploy&lt;/i&gt; (rolling update). Each repo has its own pipeline.&lt;br&gt;&lt;br&gt;&lt;b&gt;Built by&lt;/b&gt; paylab-infra/terraform (terraform apply = 73 resources). The Route 53 public zone, the ACM certificate and the GitHub connection live outside Terraform and survive terraform destroy.&lt;br&gt;&lt;br&gt;&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;━━ request traffic · ┅┅ supporting (DNS, image pull, secrets, logs, deploy)&lt;br&gt;Green box = public subnet · red outline = security group · blue dashed = Availability Zone&lt;/div&gt;" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F8F9FA;strokeColor=#AAB7B8;fontColor=#232F3E;fontSize=11;verticalAlign=top;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="1990" y="70" width="420" height="1410" as="geometry"/>
        </mxCell>

