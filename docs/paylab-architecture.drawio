        <mxCell id="sub-c" value="Public subnet · default public subnet · 172.31.0.0/20 · 0.0.0.0/0 → IGW" style="points=[[0,0],[0.25,0],[0.5,0],[0.75,0],[1,0],[1,0.25],[1,0.5],[1,0.75],[1,1],[0.75,1],[0.5,1],[0.25,1],[0,1],[0,0.75],[0,0.5],[0,0.25]];outlineConnect=0;gradientColor=none;html=1;whiteSpace=wrap;fontSize=11;container=0;pointerEvents=0;collapsible=0;recursiveResize=0;shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;grStroke=0;strokeColor=#7AA116;fillColor=#F2F6E8;verticalAlign=top;align=left;spacingLeft=30;fontColor=#248814;dashed=0;" vertex="1" parent="1">
          <mxGeometry x="1122" y="350" width="326" height="690" as="geometry"/>
        </mxCell>

        <!-- Internet gateway on the VPC edge -->
        <mxCell id="igw" value="&lt;b&gt;Internet gateway&lt;/b&gt;&lt;br&gt;(default VPC)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.internet_gateway;" vertex="1" parent="1">
          <mxGeometry x="306" y="476" width="48" height="48" as="geometry"/>
        </mxCell>

        <!-- Security group: ALB (spans all three subnets) -->
        <mxCell id="alb-sg" value="Security group &lt;b&gt;alb-sg&lt;/b&gt; · inbound 80 + 443 from 0.0.0.0/0" style="fillColor=none;strokeColor=#DD3522;verticalAlign=top;fontStyle=0;fontColor=#DD3522;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="385" y="400" width="1050" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="alb" value="&lt;b&gt;Application Load Balancer&lt;/b&gt; paylab-alb (internet-facing, a node in each of the 3 subnets)&lt;br&gt;with a domain: :80 → 301 redirect to HTTPS, :443 (ACM cert)&lt;br&gt;without a domain: :80 does the routing below&lt;br&gt; → default: target group paylab-web-tg (:3000)&lt;br&gt;rule 10 host api.lab.aricxpoint.co · rule 20 path /api/* → target group paylab-tg (:8080)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.application_load_balancer;" vertex="1" parent="1">
          <mxGeometry x="520" y="430" width="64" height="64" as="geometry"/>
        </mxCell>

        <!-- Security group: app (ECS cluster, spans all three subnets) -->
        <mxCell id="app-sg" value="Security group &lt;b&gt;app-sg&lt;/b&gt; · 8080 + 3000 from alb-sg · all ports between app-sg members — &lt;b&gt;ECS cluster paylab · AWS Fargate&lt;/b&gt; (tasks get a public IP to reach ECR/SSM without a NAT gateway)" style="fillColor=#FFF7EF;fillOpacity=60;strokeColor=#DD3522;verticalAlign=top;fontStyle=0;fontColor=#DD3522;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="385" y="565" width="1050" height="300" as="geometry"/>
        </mxCell>

        <!-- ECS services (Fargate tasks) — placement across AZs is an example -->
        <mxCell id="web" value="&lt;b&gt;web&lt;/b&gt; :3000&lt;br&gt;nginx · payment page" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="507" y="620" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="pay" value="&lt;b&gt;payment-svc&lt;/b&gt; :8081&lt;br&gt;payment-svc.paylab.internal" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="507" y="760" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="gw" value="&lt;b&gt;api-gateway&lt;/b&gt; :8080&lt;br&gt;api-gateway.paylab.internal" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="882" y="620" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="wallet" value="&lt;b&gt;wallet-svc&lt;/b&gt; :8082&lt;br&gt;wallet-svc.paylab.internal" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="882" y="760" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="notify" value="&lt;b&gt;notify-svc&lt;/b&gt; :8083&lt;br&gt;notify-svc.paylab.internal" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;" vertex="1" parent="1">
          <mxGeometry x="1257" y="620" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="placement" value="&lt;i&gt;Each service runs 1 Fargate task (awsvpc: own ENI + private IP). ECS spreads tasks across the 3 subnets; the AZ shown for each service is one example, not fixed.&lt;/i&gt;" style="text;html=1;fontSize=10;fontColor=#5A6B7B;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="1150" y="745" width="270" height="70" as="geometry"/>
        </mxCell>

        <!-- Security group: DB -->
        <mxCell id="db-sg" value="Security group &lt;b&gt;db-sg&lt;/b&gt; · 5432 from app-sg only" style="fillColor=none;strokeColor=#DD3522;verticalAlign=top;fontStyle=0;fontColor=#DD3522;whiteSpace=wrap;html=1;align=left;spacingLeft=8;fontSize=11;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1135" y="895" width="300" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="rds" value="&lt;b&gt;Amazon RDS PostgreSQL 16&lt;/b&gt;&lt;br&gt;paylab-db · db.t4g.micro&lt;br&gt;single-AZ · not publicly accessible&lt;br&gt;TLS · DB subnet group: all 3 subnets" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=6;html=1;fontSize=10;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1">
          <mxGeometry x="1150" y="930" width="56" height="56" as="geometry"/>
        </mxCell>

        <!-- ================= REGIONAL SERVICES (right column, outside the VPC) ================= -->
        <mxCell id="cloudmap" value="&lt;b&gt;AWS Cloud Map&lt;/b&gt; namespace paylab.internal&lt;br&gt;(private DNS) · services: api-gateway, payment-svc,&lt;br&gt;wallet-svc, notify-svc · one instance per running task" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#8C4FFF;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloud_map;" vertex="1" parent="1">
          <mxGeometry x="1530" y="320" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="privzone" value="&lt;b&gt;Route 53 private hosted zone&lt;/b&gt; paylab.internal&lt;br&gt;associated with this VPC only · created by Cloud Map&lt;br&gt;A record per task IP · TTL 10 s · never edit by hand" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;pointerEvents=1;shape=mxgraph.aws4.hosted_zone;" vertex="1" parent="1">
          <mxGeometry x="1530" y="450" width="56" height="56" as="geometry"/>
        </mxCell>
        <mxCell id="ecr" value="&lt;b&gt;Amazon ECR&lt;/b&gt; paylab/&amp;lt;service&amp;gt; (5 repos)&lt;br&gt;tags: git commit (7 chars) + latest" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;spacingLeft=8;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ecr;" vertex="1" parent="1">
